{
  "name": "lumpesammlig",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run check:assets",
    "deploy": "npm run build && wrangler deploy",
    "preview": "astro preview",
    "check": "astro check",
    "check:assets": "node scripts/check-built-css.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "test:assets": "node --test scripts/check-built-css.test.mjs",
    "test:studies": "node --experimental-strip-types --test src/samples/012-impossible-index/held-place.test.mjs src/samples/013-switchboard/circuits.test.mjs src/samples/014-made-heavy/made-heavy.test.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "astro": "^7.2.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.9.2",
    "wrangler": "^4.125.0"
  }
}
