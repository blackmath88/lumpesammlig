---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WordArtStudio from '../../samples/008-word-art/WordArtStudio';
import WordArtRender from '../../samples/008-word-art/WordArtRender';
import { DEFAULT_WORDART_PARAMETERS } from '../../samples/008-word-art/material/parameters';
import '../samples/008-word-art/word-art-studio.css';
---

<BaseLayout title="008 WordArt — Lumpesammlig">
  <main>
    <p class="tag wa-tag">01 / OBJECT + MATERIAL READING</p>
    <h1 class="wa-headline">
      <WordArtRender parameters={{ ...DEFAULT_WORDART_PARAMETERS, text: 'WORD ART', fontSize: 110 }} idSeed="wa-hero" label="WordArt — make word art great again" />
    </h1>

    <article class="sample-notes" id="material-reading">
      <a href="/">← Collection</a>
      <p class="tag">02 / OBJECT + MATERIAL READING</p>
      <h2>From a 2000s school newsletter to a native web generator.</h2>
      <div class="cols">
        <p>The source object is not physical matter but a cultural one: the Microsoft Word WordArt gallery around the year 2000. One dialog, thirty tiles, and suddenly every soccer club, church group and homework cover was a typesetting studio for five minutes.</p>
        <p>The web translation takes the gallery seriously instead of laughing at it. Arch, inflate, deflate, chevron, wave and slant become geometric letter placement; gradient fills, thick outlines, drop shadow and 3D depth become layered SVG — no textures, no screenshots, all parameters.</p>
      </div>
    </article>

    <p class="tag wa-tag studio-tag">03 / THE GALLERY, REBUILT</p>
    <WordArtStudio client:load />

    <section class="performance-reading" aria-labelledby="performance-title">
      <p class="tag">04 / PERFORMATIVE TRANSLATION</p>
      <h2 id="performance-title">A headline you<br />could hug.</h2>
      <div class="verbs" aria-label="WordArt behaviours">
        <span>arch</span><span>inflate</span><span>shear</span><span>extrude</span><span>shadow</span><span>gleam</span>
      </div>
      <p class="performance-note">WordArt's behaviour was never subtlety: a word states itself, bends itself, and refuses to be mistaken for body text. The performative truth is deliberate, democratic exuberance — typography that non-designers were allowed to touch.</p>
    </section>

    <section class="mutations" aria-labelledby="mutations-title">
      <p class="tag">05 / INTERFACE MUTATIONS</p>
      <h2 id="mutations-title">What if UI took WordArt<br />seriously again?</h2>
      <p class="mutations-intro">Three controls borrow the generator's material instead of rendering a museum piece. Everything below is the same scene builder, applied to real interface roles.</p>
      <div class="mutation-grid">
        <div class="mutation">
          <WordArtRender parameters={{ ...DEFAULT_WORDART_PARAMETERS, text: 'DOWNLOAD', shape: 'inflate', shapeAmount: 0.5, fillMode: 'gradient', fillA: '#ffe600', fillB: '#ff6600', outlineWidth: 3, outlineColor: '#331a00', shadow: true, shadowOffset: 5, extrusion: 0, fontSize: 54, letterSpacing: 4 }} idSeed="wa-mut-btn" className="mutation-svg" label="A download button written in WordArt" />
          <p class="mutation-name">Primary action</p>
          <p class="mutation-note">A button that behaves like a gradient banner — loud on purpose, because the action is the loudest thing on the screen.</p>
        </div>
        <div class="mutation">
          <WordArtRender parameters={{ ...DEFAULT_WORDART_PARAMETERS, text: '404', shape: 'arch-down', shapeAmount: 0.7, fillMode: 'gradient', fillA: '#00b3f6', fillB: '#8a2be2', outlineWidth: 3, outlineColor: '#1d2b53', shadow: true, shadowOffset: 6, extrusion: 10, extrusionColor: '#3d2b63', fontSize: 96, letterSpacing: 8 }} idSeed="wa-mut-404" className="mutation-svg" label="A 404 page title in WordArt" />
          <p class="mutation-name">Error state</p>
          <p class="mutation-note">Failure pages already break the page's promise. WordArt lets them fail warmly, with a wink, instead of apologising in grey.</p>
        </div>
        <div class="mutation">
          <WordArtRender parameters={{ ...DEFAULT_WORDART_PARAMETERS, text: 'INSTALLING…', shape: 'wave', shapeAmount: 0.45, fillMode: 'solid', fillA: '#008080', outlineWidth: 2, outlineColor: '#003d3d', shadow: false, extrusion: 0, fontSize: 44, letterSpacing: 5 }} idSeed="wa-mut-prog" className="mutation-svg" label="A progress label in WordArt" />
          <div class="wa-progress" aria-hidden="true"><div class="wa-progress-bar"></div></div>
          <p class="mutation-name">Progress label</p>
          <p class="mutation-note">Waiting states are theatre; the wavy teal word gives the loading bar a voice while the bar itself stays honest and slow.</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .wa-tag{margin:clamp(40px,6vw,80px) clamp(20px,5vw,72px) 0;font-size:10px;letter-spacing:.2em}
  .studio-tag{margin-bottom:14px}
  .wa-headline{margin:10px clamp(20px,5vw,72px)}
  .wa-headline svg{width:min(100%,1200px);height:auto;display:block}
  .sample-notes{background:#eeeae3;color:#171917;padding:clamp(64px,10vw,130px) clamp(20px,8vw,120px)}
  .sample-notes>a{color:#525751;text-decoration:none}.sample-notes .tag{margin:0 0 18px;font-size:10px;letter-spacing:.2em}
  .sample-notes h2{font-size:clamp(42px,7vw,92px);line-height:.94;letter-spacing:-.05em;max-width:1050px;margin:0 0 54px}
  .cols{display:grid;grid-template-columns:1fr 1fr;gap:40px;max-width:960px}
  .cols p{font-size:19px;line-height:1.58;color:#4f554e;margin:0}
  .performance-reading{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);column-gap:clamp(40px,8vw,130px);padding:clamp(76px,11vw,160px) clamp(20px,8vw,120px);background:#0e7a7a;color:#eafcf9}
  .performance-reading .tag{grid-column:1/-1;margin:0 0 24px;font-size:10px;letter-spacing:.2em}
  .performance-reading h2{font-size:clamp(42px,6vw,84px);line-height:.94;letter-spacing:-.05em;margin:0 0 40px}
  .verbs{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 30px}
  .verbs span{border:1px solid rgba(234,252,249,.5);padding:8px 14px;font-size:13px;letter-spacing:.06em}
  .performance-note{font-size:18px;line-height:1.6;margin:0;max-width:460px;opacity:.92}
  .mutations{background:#101312;color:#eeeae3;padding:clamp(70px,10vw,150px) clamp(20px,5vw,72px)}
  .mutations .tag{margin:0 0 18px;font-size:10px;letter-spacing:.2em;opacity:.6}
  .mutations h2{font-size:clamp(40px,6vw,84px);line-height:.95;letter-spacing:-.05em;margin:0 0 34px;max-width:900px}
  .mutations-intro{font-size:18px;line-height:1.6;color:#b9b4a7;max-width:560px;margin:0 0 60px}
  .mutation-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(24px,4vw,48px);max-width:1400px}
  .mutation{border:1px solid rgba(238,234,227,.18);padding:clamp(22px,3vw,40px);background:#151815}
  .mutation-svg{width:100%;height:auto;max-height:150px}
  .mutation-name{font-size:11px;letter-spacing:.18em;text-transform:uppercase;margin:26px 0 10px;color:#8f9a92}
  .mutation-note{font-size:15px;line-height:1.55;color:#b9b4a7;margin:0}
  .wa-progress{margin-top:18px;height:14px;border:1px solid #008080;background:#0e1f1f}
  .wa-progress-bar{height:100%;width:38%;background:repeating-linear-gradient(90deg,#008080 0 10px,#00b3b3 10px 20px);animation:wa-crawl 1.6s linear infinite}
  @keyframes wa-crawl{from{background-position:0 0}to{background-position:20px 0}}
  @media(prefers-reduced-motion:reduce){.wa-progress-bar{animation:none}}
  @media(max-width:700px){.cols{grid-template-columns:1fr}.performance-reading{grid-template-columns:1fr}}
</style>
