---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../data/site';
import { ICONS, buildSprite, iconUse, spriteStats } from '../../samples/011-thread-icons/icons';
import '../../samples/011-thread-icons/thread-icons.css';

const sprite = buildSprite();
const stats = spriteStats();
const sizes = [24, 32, 48] as const;
---
<BaseLayout title="011 Thread Icons — Lumpesammlig" description="A contemporary embroidered icon set for digital interfaces: six familiar icons made of thread, built from an SVG stitch vocabulary in which threads follow each shape.">
  <main class="ti-page ti-root" data-thread-icons data-surface="light">
    <Fragment set:html={sprite} />
    <nav class="back"><a href={withBase('/#library')}>← collection</a><span>011 / THREAD ICONS</span></nav>

    <section class="opening">
      <p class="label">011 / MATERIAL STUDY · ICON SET</p>
      <p class="statement">Familiar icons, <em>made of thread.</em></p>
      <p class="observed">The hanger was the impulse; the grid and the flowers of the earlier studies stay as evidence. Here embroidery becomes a contemporary digital medium: six interface icons with a streetwear-patch attitude, where threads follow the shape instead of a fixed diagonal grid.</p>
    </section>

    <section class="sheet-section" aria-labelledby="sheet-heading">
      <header class="section-head">
        <p class="label">01 / CONTACT SHEET</p>
        <h2 id="sheet-heading">Six icons, three sizes,<br />two surfaces.</h2>
        <p>Detail is re-stitched per size, not shrunk: 24 px uses fewer, wider threads and a heavier cord; 32 and 48 px share a finer level. The same construction rules hold across the set: one light from the upper left, a cord around every silhouette, two or three colour regions, one small glint.</p>
      </header>
      <div class="sheet-pair">
        {['light', 'dark'].map((tone) => (
          <div class="sheet" data-tone={tone}>
            {sizes.map((size) => (
              <div class="sheet-row">
                <span>{size} px</span>
                {ICONS.map((icon) => <Fragment set:html={iconUse(icon.id, size)} />)}
              </div>
            ))}
            <div class="sheet-names"><span></span>{ICONS.map((icon) => <span>{icon.label}</span>)}</div>
          </div>
        ))}
      </div>

      <div class="enlarged">
        <div class="enlarged-stage">
          <svg class="ti" width="216" height="216" viewBox="0 0 48 48" role="img" aria-label="Enlarged construction view of the selected icon"><use data-enlarged-use href="#ti-chat-detail" /></svg>
        </div>
        <div>
          <fieldset>
            <legend>Enlarge · construction level with strands</legend>
            {ICONS.map((icon, i) => (
              <label><input type="radio" name="enlarge-icon" value={icon.id} data-label={icon.label} checked={i === 0} /> {icon.label}</label>
            ))}
          </fieldset>
          <p class="enlarged-note"><strong data-enlarged-label>Chat</strong>: this view is for inspecting the stitching, not how the icon is used. Strands and the wrapped cord highlight exist only at this level.</p>
          <ul class="construction-notes">
            {ICONS.map((icon) => <li><strong>{icon.label}</strong> {icon.note}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="toolbar-section" aria-labelledby="toolbar-heading">
      <header class="section-head">
        <p class="label">02 / IN CONTEXT</p>
        <h2 id="toolbar-heading">A toolbar you can press.</h2>
        <p>Native buttons with accessible names; the patches are decoration. Hover or focus lifts a patch slightly. Selection adds a contrasting running stitch. The chat button carries a knot-like badge. Upload is a labelled, simulated state change: it flips immediately, the knot only follows.</p>
      </header>
      <div class="toolbar-wrap">
        <div class="toolbar-head">
          <span>Surface</span>
          <button type="button" class="surface-toggle" data-surface-toggle aria-pressed="false">Dark surface</button>
        </div>
        <ul class="toolbar" aria-label="Tools">
          {ICONS.filter((i) => i.id !== 'upload').map((icon) => (
            <li>
              <button type="button" data-tool={icon.id} aria-pressed={icon.id === 'headphones' ? 'true' : 'false'}>
                <Fragment set:html={iconUse(icon.id, 32)} />
                <span class="vh">{icon.label}{icon.id === 'chat' ? ', 3 unread' : ''}</span>
                {icon.id === 'chat' && <span class="badge" aria-hidden="true"></span>}
              </button>
            </li>
          ))}
          <li>
            <button type="button" class="upload-button" data-upload data-state="idle">
              <Fragment set:html={iconUse('upload', 32)} />
              <span class="label-idle">Upload (simulated)</span>
              <span class="label-done">Uploaded (simulated)</span>
              <span class="done-knot" aria-hidden="true"></span>
            </button>
          </li>
        </ul>
        <p class="tool-status" data-tool-status aria-live="polite">Headphones selected.</p>
      </div>
    </section>

    <section class="method" aria-labelledby="method-heading">
      <header class="section-head">
        <p class="label">03 / CONSTRUCTION AND RENDERING</p>
        <h2 id="method-heading">Threads follow the shape.</h2>
      </header>
      <ol>
        <li><span>Fill</span><p>Parallel satin stitches at a chosen angle, cut exactly to the region by intersecting each stitch with the polygon. No clipping paths, nothing outside the boundary.</p></li>
        <li><span>Fan</span><p>Stitches radiating from a centre and clipped the same way, for the headphone arch and the cloud lobes. Spacing is set at the outer edge so the fan stays covered.</p></li>
        <li><span>Cord</span><p>A contour stroked three times: a contact shadow, the cord body, a wrapped highlight made with a dashed round-capped stroke.</p></li>
        <li><span>Layers</span><p>Regions draw in order with a darker ground showing between threads and a contact shadow where one layer sits on another.</p></li>
        <li><span>Rendering</span><p>Static SVG generated at build time: {stats.symbols} symbols, {stats.nodes} paths, about {Math.round(stats.bytes / 1024)} KB inline, reused through <code>&lt;use&gt;</code>. No runtime drawing, crisp at any pixel ratio. The earlier Canvas decision was for a different experiment.</p></li>
      </ol>
      <p class="method-note">Sample 009's photograph and sample 010's comparison remain the evidence of the exploration. This set does not reproduce any reference artwork; the construction qualities it translates are fanned fills, curved stitch directions, raised outlines and layered regions. The full note, references and reflection are in <code>src/samples/011-thread-icons/sample.md</code>.</p>
    </section>

    <footer><span>011 / THREAD ICONS</span><span>chart → contour → thread → patch → toolbar</span></footer>
  </main>
</BaseLayout>

<script>
  import { mountThreadIcons } from '../../samples/011-thread-icons/toolbar';
  const root = document.querySelector<HTMLElement>('[data-thread-icons]');
  if (root) mountThreadIcons(root);
</script>

<style>
  .ti-page{background:#e9e6df;color:#1b1e1d;overflow-x:clip}
  .label{font-size:10px;letter-spacing:.21em;font-weight:760;margin:0;opacity:.58}
  .back{display:flex;justify-content:space-between;gap:16px;max-width:1420px;margin:auto;padding:22px clamp(22px,6vw,88px) 18px;font-size:11px;letter-spacing:.14em;text-transform:uppercase}
  .back a{text-decoration:none;opacity:.75}.back a:hover,.back a:focus-visible{opacity:1}.back span{opacity:.55}
  .opening,.sheet-section,.toolbar-section,.method,footer{max-width:1420px;margin:auto;padding-left:clamp(22px,6vw,88px);padding-right:clamp(22px,6vw,88px)}
  .opening{display:grid;grid-template-columns:.32fr 1.25fr .52fr;gap:clamp(28px,5vw,86px);padding-top:clamp(60px,8vw,110px);padding-bottom:clamp(60px,8vw,100px);align-items:start}
  .statement{font-size:clamp(38px,5.5vw,78px);line-height:.98;letter-spacing:-.055em;margin:0}.statement em{font-style:normal;font-weight:400;color:#ff3d9a}
  .observed{font-size:18px;line-height:1.55;margin:8px 0 0;color:#5b605c}
  .section-head{display:grid;grid-template-columns:.8fr 1.2fr;gap:6vw;align-items:end;margin-bottom:28px}
  .section-head .label{grid-column:1/-1}
  .section-head p:not(.label){margin:0;font-size:16px;line-height:1.55;color:#5b605c}
  .sheet-section,.toolbar-section,.method{padding-top:60px;padding-bottom:80px;border-top:1px solid #c3bfb4}
  .sheet-section h2,.toolbar-section h2,.method h2{font-size:clamp(34px,4.6vw,66px);line-height:.95;letter-spacing:-.055em;margin:14px 0 0;font-weight:620}
  .construction-notes{list-style:none;margin:18px 0 0;padding:0;font-size:13px;line-height:1.5;color:#5b605c}
  .construction-notes li{padding:6px 0;border-top:1px solid #d6d2c7}
  .construction-notes strong{display:inline-block;min-width:110px;color:#1b1e1d;font-weight:650}
  .method ol{list-style:none;padding:0;margin:0;border-top:1px solid #c3bfb4}
  .method li{display:grid;grid-template-columns:120px 1fr;gap:24px;padding:18px 0;border-bottom:1px solid #cfcbc0}
  .method li span{font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#2a7f9f;padding-top:4px}
  .method li p{margin:0;color:#5b605c;line-height:1.5;font-size:15px;max-width:820px}
  .method-note{margin:24px 0 0;font-size:14px;line-height:1.55;color:#5b605c;max-width:820px}
  code{font-size:12px}
  footer{display:flex;justify-content:space-between;gap:20px;border-top:1px solid #c3bfb4;padding-top:22px;padding-bottom:55px;font-size:10px;letter-spacing:.16em;text-transform:uppercase;opacity:.58}
  @media(max-width:900px){.opening{grid-template-columns:1fr}.section-head{grid-template-columns:1fr}}
  @media(max-width:620px){.method li{grid-template-columns:1fr;gap:6px}footer{flex-direction:column}.construction-notes strong{display:block}}
</style>
