---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnitSurface from '../../samples/001-waschlumpe/KnitSurface';
import MaterialLab from '../../samples/001-waschlumpe/MaterialLab';
---
<BaseLayout title="001 Waschlumpe — Lumpesammlig">
  <main>
    <KnitSurface collectionHref="#material-reading" client:load />
    <article class="sample-notes" id="material-reading">
      <a href="/">← Collection</a>
      <p class="tag">02 / OBJECT + MATERIAL READING</p>
      <h2>From loose cotton knit to responsive surface.</h2>
      <div class="cols">
        <p>The source object is deliberately ordinary: a loosely knitted washcloth. Its appeal comes from open stitches, uneven tension, softness and an accidental colour transition.</p>
        <p>The web translation avoids using the object as a flat image. Instead, the surface is reconstructed procedurally and reacts to pointer movement as if tension travels through cloth.</p>
      </div>
    </article>
    <section class="performance-reading" aria-labelledby="performance-title">
      <p class="tag">03 / PERFORMATIVE TRANSLATION</p>
      <h2 id="performance-title">A connected field<br />does not move alone.</h2>
      <div class="verbs" aria-label="Material behaviours">
        <span>stretch</span><span>yield</span><span>connect</span><span>sag</span><span>tighten</span><span>relax</span>
      </div>
      <p class="performance-note">Pull one stitch and its neighbours negotiate the force. This propagation—soft, delayed and local—becomes the governing interface behaviour.</p>
    </section>
    <MaterialLab client:visible />
  </main>
</BaseLayout>
<style is:global>
  .sample-notes{background:#eeeae3;color:#171917;padding:clamp(64px,10vw,130px) clamp(20px,8vw,120px)}
  .sample-notes>a{color:#525751;text-decoration:none}.sample-notes .tag{margin:80px 0 18px;font-size:10px;letter-spacing:.2em}.sample-notes h2{font-size:clamp(42px,7vw,92px);line-height:.94;letter-spacing:-.05em;max-width:1050px;margin:0 0 54px}.cols{display:grid;grid-template-columns:1fr 1fr;gap:40px;max-width:960px}.cols p{font-size:19px;line-height:1.58;color:#4f554e;margin:0}@media(max-width:700px){.cols{grid-template-columns:1fr}}
  .performance-reading{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);column-gap:clamp(40px,8vw,130px);padding:clamp(76px,11vw,160px) clamp(20px,8vw,120px);background:#c9cec0;color:#171b17}.performance-reading .tag{grid-column:1/-1;margin:0 0 24px;font-size:10px;letter-spacing:.2em}.performance-reading h2{grid-column:1/-1;margin:0 0 clamp(58px,8vw,110px);max-width:1100px;font-size:clamp(48px,8vw,108px);line-height:.9;letter-spacing:-.06em;font-weight:620}.verbs{display:flex;flex-wrap:wrap;align-content:flex-start;gap:8px}.verbs span{padding:11px 14px;border:1px solid rgba(23,27,23,.32);font-size:12px;letter-spacing:.14em;text-transform:uppercase}.performance-note{max-width:480px;margin:0;color:#4d574e;font-size:19px;line-height:1.62}@media(max-width:700px){.performance-reading{grid-template-columns:1fr;row-gap:36px}.performance-reading h2{margin-bottom:20px}}
</style>
