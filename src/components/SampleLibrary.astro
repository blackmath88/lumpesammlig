---
import { samples } from '../data/samples';
import KnitMaterial from '../samples/001-waschlumpe/material/KnitMaterial';
import { DEFAULT_KNIT_PARAMETERS } from '../samples/001-waschlumpe/material/parameters';
import CordField from '../samples/003-soft-green/CordField';
import { DEFAULT_CORD_PARAMETERS } from '../samples/003-soft-green/material/parameters';
import CoilField from '../samples/004-blue-coil/CoilField';
import { DEFAULT_COIL_PARAMETERS } from '../samples/004-blue-coil/material/parameters';
import PaintField from '../samples/006-flaked-blue/PaintField';
import { DEFAULT_PAINT_PARAMETERS } from '../samples/006-flaked-blue/material/parameters';
import PaperField from '../samples/007-blue-printed-paper/PaperField';
import { DEFAULT_PAPER_PARAMETERS } from '../samples/007-blue-printed-paper/material/parameters';
import WordArtMini from '../samples/008-word-art/WordArtMini';
---
<section class="library" id="library">
  <header class="library-head">
    <p class="eyebrow">THE COLLECTION / {String(samples.length).padStart(3, '0')} OBJECT</p>
    <h2>Real things,<br />still behaving strangely.</h2>
    <p class="intro">Each entry keeps one material, visual or behavioural truth from a physical object, then lets that truth choose its own native web form.</p>
  </header>

  <div class="promenade">
    {samples.map((sample) => (
      <a class="sample" href={sample.route} data-sample={sample.id}>
        <div class="sample-index">
          <span>{sample.number}</span>
          <span>{sample.status}</span>
        </div>
        <div class="preview" aria-hidden="true">
          {sample.id === 'waschlumpe'
            ? <KnitMaterial parameters={DEFAULT_KNIT_PARAMETERS} quality="small" active={false} className="mini-knit-live" label="" client:visible />
            : sample.id === 'blue-coil-basket'
              ? <CoilField bare parameters={DEFAULT_COIL_PARAMETERS} quality="small" interactive={false} className="mini-live" label="" client:visible />
              : sample.id === 'flaked-blue-painted-wood'
                ? <PaintField bare parameters={DEFAULT_PAINT_PARAMETERS} quality="small" interactive={false} className="mini-live" label="" client:visible />
                : sample.id === 'blue-printed-paper'
                  ? <PaperField bare parameters={DEFAULT_PAPER_PARAMETERS} quality="small" interactive={false} className="mini-live" label="" client:visible />
                  : sample.id === 'word-art'
                    ? <WordArtMini className="mini-live" client:visible />
                    : <CordField bare parameters={DEFAULT_CORD_PARAMETERS} quality="small" interactive={false} className="mini-live" label="" client:visible />}
          <span class="enter">enter study ↗</span>
        </div>
        <div class="sample-copy">
          <h3>{sample.title}</h3>
          <p class="object">{sample.object}</p>
          <dl>
            <div><dt>Observed</dt><dd>{sample.material}</dd></div>
            <div><dt>Translated as</dt><dd>{sample.translation}</dd></div>
            <div><dt>Boundary</dt><dd>{sample.technology.join(' / ')}</dd></div>
          </dl>
        </div>
      </a>
    ))}
  </div>

  <p class="open-end"><span>Next</span> The collection waits for another real object. No empty specimen is invented in advance.</p>
</section>

<style>
  .library{background:#eeeae3;color:#161816;padding:clamp(76px,11vw,156px) clamp(20px,5vw,72px) clamp(90px,14vw,190px)}
  .library-head{display:grid;grid-template-columns:.42fr 1.2fr .72fr;gap:clamp(24px,4vw,72px);align-items:start;margin:0 auto clamp(80px,11vw,150px);max-width:1400px}
  .eyebrow{font-size:10px;letter-spacing:.22em;font-weight:750;margin:8px 0 0;opacity:.55}
  h2{font-size:clamp(46px,6.7vw,94px);line-height:.91;letter-spacing:-.058em;margin:0;font-weight:650}
  .intro{font-size:clamp(16px,1.65vw,20px);line-height:1.5;margin:8px 0 0;color:#4b504a}
  .promenade{max-width:1400px;margin:auto}
  .sample{display:grid;grid-template-columns:minmax(54px,.18fr) minmax(300px,1.35fr) minmax(260px,.72fr);gap:clamp(20px,4vw,68px);color:inherit;text-decoration:none;border-top:1px solid rgba(22,24,22,.3);padding-top:15px;align-items:start}
  .sample+.sample{margin-top:clamp(110px,15vw,210px)}
  .sample-index{display:flex;flex-direction:column;gap:7px;text-transform:uppercase;font-size:10px;letter-spacing:.18em}.sample-index span:last-child{opacity:.5}
  .preview{height:clamp(390px,52vw,700px);position:relative;background:#171a17;overflow:hidden;transform:rotate(-1.15deg);transition:transform .5s cubic-bezier(.2,.7,.2,1)}
  .sample:hover .preview{transform:rotate(.15deg) scale(.995)}
  .preview :global(.mini-knit-live),.preview :global(.mini-live){position:absolute;inset:0;display:block;width:100%;height:100%;background:#151815}
  .enter{position:absolute;right:18px;bottom:17px;background:#eeeae3;color:#171917;padding:10px 13px;font-size:11px;letter-spacing:.08em;text-transform:uppercase}
  .sample-copy{padding-top:clamp(20px,5vw,70px)}
  h3{font-size:clamp(42px,5vw,74px);line-height:.95;letter-spacing:-.05em;margin:0 0 24px}
  .object{color:#4d534c;font-size:18px;line-height:1.5;margin:0 0 54px;max-width:460px}
  dl{margin:0;border-top:1px solid rgba(22,24,22,.18)}dl div{padding:13px 0;border-bottom:1px solid rgba(22,24,22,.13)}
  dt{text-transform:uppercase;font-size:9px;letter-spacing:.16em;margin-bottom:5px;color:#777d76}dd{margin:0;font-size:13px;line-height:1.4}
  .open-end{max-width:1400px;margin:clamp(100px,14vw,190px) auto 0;border-top:1px solid rgba(22,24,22,.2);padding-top:16px;color:#757a74;font-size:13px;letter-spacing:.04em}.open-end span{text-transform:uppercase;font-size:9px;letter-spacing:.18em;margin-right:28px;color:#171917}
  @media(max-width:900px){.library-head{grid-template-columns:1fr}.sample{grid-template-columns:64px 1fr}.sample-copy{grid-column:2}.preview{height:min(72vw,620px)}}
  @media(max-width:620px){.sample{grid-template-columns:1fr}.sample-index{flex-direction:row;justify-content:space-between}.sample-copy{grid-column:auto}.preview{height:92vw}.library-head{margin-bottom:72px}}
</style>
